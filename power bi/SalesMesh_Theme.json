{
  "name": "SalesMesh",
  "dataColors": ["#185FA5", "#1D9E75", "#BA7517", "#888780", "#534AB7", "#D85A30", "#993556", "#3B6D11"],
  "background": "#FFFFFF",
  "foreground": "#252423",
  "tableAccent": "#185FA5",
  "good": "#1D9E75",
  "neutral": "#BA7517",
  "bad": "#A32D2D",
  "textClasses": {
    "callout": { "fontSize": 32, "fontFace": "Segoe UI Semibold", "color": "#252423" },
    "title": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#252423" },
    "header": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#252423" },
    "label": { "fontSize": 10, "fontFace": "Segoe UI", "color": "#605E5C" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#F5F5F3" } }, "transparency": 0 }],
        "border": [{ "show": false, "radius": 8 }],
        "dropShadow": [{ "show": false }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }]
      }
    }
  }
}
