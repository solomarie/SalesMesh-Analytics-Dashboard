# Copy this file, name the copy ".env" (in this same app folder) and fill in the values.
# .env is listed in .gitignore, so it is never uploaded to GitHub.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=salesmesh
DB_USER=salesmesh_app

# Password for the app's own MySQL account. setup_database.py creates the account with it.
# Use at least 12 characters with letters, numbers and a symbol. Do not reuse your root password.
DB_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

# Password given to all six demo accounts (admin@, manager@, jane@, brian@, aisha@, kevin@salesmesh.com).
DEMO_PASSWORD=REPLACE_WITH_A_DEMO_PASSWORD

SESSION_TIMEOUT_MINUTES=30
